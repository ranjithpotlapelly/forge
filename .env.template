# Copy this file to `.env` and fill in values. `.env` is gitignored.

# Ollama server (default is fine for local dev)
OLLAMA_HOST=http://localhost:11434

# Phoenix OTLP/gRPC collector (default is fine for local dev; docker-compose
# overrides this to http://phoenix:4317 when Forge itself runs in a container)
PHOENIX_ENDPOINT=http://localhost:4317

# The real git-root checkout the task path (plan/edit/test/commit/push/PR)
# targets -- REQUIRED for that path to work; leaving this blank breaks
# prepare_workspace, `python -m app.index` with no argument, and
# retriever.graph_expand's context reads. Use your host path here (Windows:
# forward slashes, e.g. C:/Users/you/projects/your-repo) -- docker-compose
# overrides this to the container-side bind-mount path
# (/mnt/host_projects/<repo>) when Forge itself runs in a container, same as
# OLLAMA_HOST/PHOENIX_ENDPOINT above. NOT the same as whatever path you last
# passed to /index, which only affects Q&A retrieval.
FORGE_REPO_PATH=C:/path/to/your/repo

# Only needed for a native (non-Docker) run against a JS/TS repo whose test
# suite uses Karma/ChromeHeadless (e.g. Angular's `ng test`) -- on Windows
# especially, karma-chrome-launcher's default lookup path frequently doesn't
# match where Chrome is actually installed, so run_tests fails with "Can not
# find the binary" until this is set explicitly. Docker doesn't need this
# (Dockerfile already sets it to the container's chromium install).
CHROME_BIN=C:/path/to/chrome.exe

# GitHub — needed in Phase 7 (issues/PRs). Leave blank until then.
# Create a fine-grained token with access to the repo you want Forge to work on.
GITHUB_TOKEN=

# Optional (upgrade path): a hosted endpoint for the code-edit step.
# Leave blank to keep everything local.
CODE_MODEL_API_KEY=
CODE_MODEL_BASE_URL=
# Fallback chain tried in this order by OpenRouter itself (see config.yaml's
# code_model.models). Leave FALLBACK_1/2 blank if you don't want fallbacks --
# app/wiring.py drops blank entries before building the models list.
CODE_MODEL_NAME=
CODE_MODEL_FALLBACK_1=
CODE_MODEL_FALLBACK_2=

# Optional: a Slack Incoming Webhook URL for "task complete"/"PR opened"
# notifications. Leave blank to keep notify_slack a silent no-op.
SLACK_WEBHOOK_URL=

# Optional: a running Qdrant server (retriever.adapter: qdrant, an alternative
# to the default chroma). Leave blank to use embedded/on-disk Qdrant instead
# (retriever.qdrant_path in config.yaml) -- no server needed either way.
QDRANT_URL=
